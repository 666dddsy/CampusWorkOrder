<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.campusworkorder.mapper.TicketLogMapper">

    <insert id="insert"
            parameterType="com.example.campusworkorder.entity.TicketLog">

        INSERT INTO ticket_log
        (
        ticket_id,
        operator_id,
        from_status,
        to_status,
        note
        )
        VALUES
        (
        #{ticketId},
        #{operatorId},
        #{fromStatus, jdbcType=VARCHAR},
        #{toStatus},
        #{note}
        )

    </insert>

</mapper>