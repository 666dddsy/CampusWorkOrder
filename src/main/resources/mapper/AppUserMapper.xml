<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.campusworkorder.mapper.AppUserMapper">

    <select id="selectRoleById"
            resultType="com.example.campusworkorder.domain.enums.UserRole">
        select role from app_user
        where id=#{id}
    </select>

    <select id="selectByUsername"
            resultType="com.example.campusworkorder.entity.AppUser">
        SELECT id, username, password_hash, role
        FROM app_user
        WHERE username = #{username}
    </select>

</mapper>